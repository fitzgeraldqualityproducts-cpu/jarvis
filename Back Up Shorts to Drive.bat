@echo off
title Back Up Shorts to Drive
cd /d "%~dp0"
if not exist ".venv\Scripts\python.exe" if exist "%USERPROFILE%\Jarvis\.venv\Scripts\python.exe" cd /d "%USERPROFILE%\Jarvis"
set PYTHONUTF8=1
if not exist ".venv\Scripts\python.exe" (
  echo Jarvis isn't installed on this PC yet. Double-click "Install Jarvis" first.
  pause
  exit /b 1
)
echo Copies finished Shorts to Google Drive now and checks every copy.
".venv\Scripts\python.exe" -m studio drive backup %*
echo.
pause
